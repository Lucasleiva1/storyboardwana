{
  "name": "framesync",
  "version": "0.1.1",
  "private": true,
  "description": "Local-first audiovisual preproduction workspace and browser capture bridge.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:desktop": "pnpm --filter @framesync/desktop build",
    "build:extension": "pnpm --filter @framesync/extension build",
    "build:native-host": "cargo build --manifest-path crates/native-host/Cargo.toml",
    "dev:desktop": "pnpm --filter @framesync/desktop tauri dev",
    "dev:desktop:web": "pnpm --filter @framesync/desktop dev",
    "dev:extension": "pnpm --filter @framesync/extension dev",
    "format": "prettier --write . && cargo fmt --all",
    "lint": "pnpm -r --if-present lint && cargo clippy --workspace --all-targets -- -D warnings",
    "release:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1",
    "test": "pnpm -r --if-present test && cargo test --workspace",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-prereqs.ps1"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
